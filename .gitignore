# Datasets — large, git-ignored (see data/README.md for download URLs)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated figures (keep the directory)
reports/figures/*
!reports/figures/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Notebooks
.ipynb_checkpoints/

# OS / editor cruft
.DS_Store
